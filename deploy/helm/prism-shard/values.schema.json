{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "service",
    "timeoutMs",
    "writeEnabled",
    "storage",
    "secrets",
    "objectStore",
    "topology",
    "networkPolicy",
    "podDisruptionBudget",
    "terminationGracePeriodSeconds"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {"port": {"type": "integer", "minimum": 1024, "maximum": 65535}}
    },
    "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 60000},
    "writeEnabled": {"type": "boolean"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
    "topologySpreadMaxSkew": {"type": "integer", "minimum": 1},
    "storage": {
      "type": "object",
      "required": ["size", "retentionPolicy"],
      "properties": {
        "size": {"type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"},
        "className": {"type": "string"},
        "retentionPolicy": {
          "type": "object",
          "required": ["whenDeleted", "whenScaled"],
          "additionalProperties": false,
          "properties": {
            "whenDeleted": {"enum": ["Retain", "Delete"]},
            "whenScaled": {"enum": ["Retain", "Delete"]}
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["serverTls", "coordinatorCa", "objectStore"],
      "additionalProperties": false,
      "properties": {
        "serverTls": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253},
        "coordinatorCa": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253},
        "objectStore": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253}
      }
    },
    "objectStore": {
      "type": "object",
      "required": ["endpoint", "bucket", "region"],
      "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string", "minLength": 1, "maxLength": 253},
        "bucket": {"type": "string", "minLength": 1, "maxLength": 253},
        "region": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "topology": {
      "type": "object",
      "required": ["version", "shards"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 1},
        "shards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["shard_id", "address", "server_name"],
            "additionalProperties": false,
            "properties": {
              "shard_id": {"type": "integer", "minimum": 0},
              "address": {"type": "string", "minLength": 1},
              "server_name": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "coordinatorNamespaceLabels",
        "coordinatorPodLabels",
        "modelNamespaceLabels",
        "modelPodLabels",
        "modelPort",
        "monitoringNamespaceLabels",
        "monitoringPodLabels",
        "objectStoreCidr",
        "objectStorePort"
      ],
      "properties": {
        "coordinatorNamespaceLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "coordinatorPodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "modelNamespaceLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "modelPodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "modelPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "monitoringNamespaceLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "monitoringPodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "objectStoreCidr": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"},
        "objectStorePort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["maxUnavailable"],
      "additionalProperties": false,
      "properties": {
        "maxUnavailable": {"type": "integer", "minimum": 1}
      }
    }
  }
}
