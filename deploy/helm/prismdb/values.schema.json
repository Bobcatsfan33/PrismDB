{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "serverName", "secrets", "topology", "networkPolicy"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 2},
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {"port": {"type": "integer", "minimum": 1024, "maximum": 65535}}
    },
    "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 60000},
    "serverName": {"type": "string", "minLength": 1, "maxLength": 253},
    "secrets": {
      "type": "object",
      "required": ["serverTls", "shardTls", "authorizationPolicy", "probeTls"],
      "properties": {
        "serverTls": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253},
        "shardTls": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253},
        "authorizationPolicy": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253},
        "probeTls": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253}
      }
    },
    "topology": {
      "type": "object",
      "required": ["version", "shards"],
      "properties": {
        "version": {"const": 1},
        "shards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["shard_id", "address", "server_name"],
            "properties": {
              "shard_id": {"type": "integer", "minimum": 0},
              "address": {"type": "string", "minLength": 1},
              "server_name": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "ingressNamespaceLabels",
        "ingressPodLabels",
        "shardNamespaceLabels",
        "shardPodLabels",
        "shardPort"
      ],
      "properties": {
        "ingressNamespaceLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "ingressPodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "shardNamespaceLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "shardPodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "shardPort": {"type": "integer", "minimum": 1024, "maximum": 65535}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["minAvailable"],
      "properties": {
        "minAvailable": {"type": "integer", "minimum": 1}
      }
    }
  }
}
